---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"time">, "datetime"> & {
  date: Date;
  format: "date" | "datetime";
};

const { date, format, ...attrs } = Astro.props;

const parts = Object.fromEntries(
  new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  })
    .formatToParts(date)
    .map(({ type, value }) => [type, value]),
);
const ymd = `${parts.year}/${parts.month}/${parts.day}`;
const [datetime, text] =
  format === "date"
    ? [`${parts.year}-${parts.month}-${parts.day}`, ymd]
    : [date.toISOString(), `${ymd} (${parts.hour}:${parts.minute})`];
---

<time datetime={datetime} {...attrs}>{text}</time>
