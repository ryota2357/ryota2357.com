---
type Props = {
  title: string;
};

const { title } = Astro.props;
---

<section>
  <h2>{title}</h2>
  <div class="body"><slot /></div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  h2 {
    font-size: 1.6rem;
    font-weight: bold;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding-left: 1rem;
  }
</style>
