---
import { Image } from "astro:assets";
import CCBYImage from "@/images/cc-by.png";

type Props = Record<PropertyKey, never>;
---

<footer>
  <div class="license">
    <a rel="license" href="https://creativecommons.org/licenses/by/4.0/deed.ja">
      <Image src={CCBYImage} alt="CC-BY License" class="license-badge" />
    </a>
    <p class="license-text">
      注があるものを除いて、このサイトの内容物は
      <a href="https://creativecommons.org/licenses/by/4.0/deed.ja"
        >クリエイティブ・コモンズ 表示 4.0 ライセンス</a
      >
      の下で提供されています。
    </p>
  </div>
  <p data-vrt-mask>
    Built with{" "}
    <a href="https://astro.build/">{Astro.generator}</a>
  </p>
</footer>

<style>
  footer {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.8rem;
  }

  .license {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .license-badge {
    width: auto;
    height: 2rem;
  }

  .license-text {
    text-align: left;
  }
</style>
