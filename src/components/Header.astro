---
import HeaderLink from "./HeaderLink.astro";

type Props = Record<PropertyKey, never>;
---

<header>
  <a href="/" class="site-title">ryota2357</a>
  <nav aria-label="メイン">
    <ul>
      <li><HeaderLink href="/">Home</HeaderLink></li>
      <li><HeaderLink href="/about/">About</HeaderLink></li>
      <li><HeaderLink href="/blog/">Blog</HeaderLink></li>
      <li><HeaderLink href="/projects/">Projects</HeaderLink></li>
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 0.5rem 0.75rem 1rem;
  }

  .site-title {
    font-size: 2.1rem;
    font-weight: bold;
    color: var(--color-text-strong);
    user-select: none;

    &:hover {
      text-decoration: none;
    }
  }

  nav {
    margin-top: auto;
  }

  ul {
    display: flex;
    font-size: 1.4rem;
  }

  li {
    margin: 0 0.7rem;
  }
</style>
