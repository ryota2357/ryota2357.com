---
type Props = { href: string };
const { href } = Astro.props;
const isCurrent = Astro.url.pathname === href;
---

{isCurrent ? (
  // biome-ignore lint/a11y/useValidAnchor: The HTML spec marks up the current page in a navigation as a placeholder link without href.
  <a aria-current="page">
    <slot />
  </a>
) : (
  <a href={href}>
    <slot />
  </a>
)}

<style>
  a {
    text-decoration: underline transparent;
    transition: text-decoration-color 0.2s ease-in-out;

    &:hover,
    &[aria-current="page"] {
      text-decoration-color: currentColor;
    }
  }
</style>
