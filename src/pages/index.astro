---
import { Image } from "astro:assets";
import path from "node:path";
import ContentBlock from "@/components/ContentBlock.astro";
import { allBlogCollection, allBlogTagList } from "@/content";
import AvatarImage from "@/images/avatar.png";
import Base from "@/layouts/Base.astro";

const top12BlogTagList = [...allBlogTagList]
  .sort((a, b) => a.name.localeCompare(b.name))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);
---

<Base title="Home" type="website">
  <div class="profile">
    <Image
      src={AvatarImage}
      alt="Avatar"
      width={200}
      height={200}
      loading="eager"
      class="avatar"
    />
    <h1 class="name">ryota2357</h1>
  </div>
  <div class="blocks">
    <ContentBlock title="Affiliation">
      <ul class="bullets">
        <li>
          電気通信大学大学院 情報理工学研究科 情報・ネットワーク工学専攻 1年
        </li>
        <li>電気通信大学MMA(サークル)</li>
        <li>電気通信大学小宮研究室</li>
      </ul>
    </ContentBlock>
    <ContentBlock title="Blog">
      <div class="row">
        <h3>タグ</h3>
        <ul class="row-body tags" data-vrt-mask>
          {top12BlogTagList.map(({ name, count }) => (
            <li>
              <a
                href={`/blog/tag/${name.replace("#", "%23")}/`}
              >{`${name}(${count})`}</a>
            </li>
          ))}
          <li><a href="/blog/tag/">一覧</a></li>
        </ul>
      </div>
      <div class="row">
        <h3>更新</h3>
        <ul class="row-body bullets" data-vrt-mask>
          {[...allBlogCollection]
            .sort((a, b) => b.data.update.valueOf() - a.data.update.valueOf())
            .slice(0, 7)
            .map((post) => (
              <li>
                <a href={path.join("/blog", post.id, "/")}>{post.data.title}</a>
              </li>
            ))}
        </ul>
      </div>
    </ContentBlock>
    <ContentBlock title="Links">
      <ul class="bullets">
        <li>
          <a href="https://twitter.com/95s7k84695a"> Twitter (@95s7k84695a)</a>
        </li>
        <li>
          <a href="https://bsky.app/profile/ryota2357.com">
            Bluesky (@ryota2357.com)
          </a>
        </li>
        <li><a href="https://github.com/ryota2357"> Github (ryota2357)</a></li>
        <li>
          <a href="https://atcoder.jp/users/ryota2357"> AtCoder (ryota2357)</a>
        </li>
        <li>
          <a href="https://unityroom.com/users/ryota2357">
            UnityRoom (ryota2357)
          </a>
        </li>
      </ul>
    </ContentBlock>
  </div>
</Base>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .avatar {
    border-radius: 50%;
  }

  .name {
    font-size: 1.6rem;
    font-weight: bold;
  }

  .blocks {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .bullets {
    list-style: disc inside;
  }

  .bullets > li {
    padding: 0.125rem 0;
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  h3 {
    flex: none;
    font-size: 1.3rem;
    font-weight: bold;
  }

  .row-body {
    margin: auto 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tags > li {
    padding: 0.3rem;
  }
</style>
