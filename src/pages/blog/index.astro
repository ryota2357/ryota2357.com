---
import BlogList from "@/components/BlogList.astro";
import PageTitle from "@/components/PageTitle.astro";
import { allBlogCollection } from "@/content";
import Base from "@/layouts/Base.astro";

const sortedAllBlogCollection = [...allBlogCollection].sort(
  (a, b) => b.data.postdate.valueOf() - a.data.postdate.valueOf(),
);
---

<Base title="Blog" type="website">
  <PageTitle title="Blog" />
  <p class="tag-index-link"><a href="/blog/tag/">タグの一覧</a></p>
  <div><BlogList posts={sortedAllBlogCollection} /></div>
</Base>

<style>
  .tag-index-link {
    margin: 0.5rem 0;
  }
</style>
