---
import { allBlogTagList } from "@/content";
import Base from "@/layouts/Base.astro";

const sortedAllBlogTagList = [...allBlogTagList]
  .sort((a, b) => a.name.localeCompare(b.name))
  .sort((a, b) => b.count - a.count);
---

<Base title="Blog.Tag" type="website" noindex={true}>
  <h1>
    <span class="parent"><a href="/blog/">Blog</a>.</span>
    <span class="current">Tag</span>
  </h1>
  <ul class="tags">
    {sortedAllBlogTagList.map(({ name, count }) => (
      <li>
        <a
          href={`/blog/tag/${name.replace("#", "%23")}/`}
        >{`${name}(${count})`}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .parent {
    font-size: 1.6rem;
  }

  .current {
    font-size: 2.5rem;
  }

  .tags {
    margin-top: 2rem;
    list-style: disc inside;
  }
</style>
