---
import { render } from "astro:content";
import path from "node:path";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import dayjs from "dayjs";
import { allBlogCollection, util, vrtBlogCollection } from "@/content";
import TagIcon from "@/images/tag-icon.svg";
import Base from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
  const blogPaths = [...allBlogCollection]
    .sort((a, b) => a.data.postdate.valueOf() - b.data.postdate.valueOf())
    .map((post, index, self) => ({
      params: {
        year: util.getYearFromSlug(post.id),
        slug: util.stripYearFromSlug(post.id),
      },
      props: {
        post,
        prevPost: index !== 0 ? self[index - 1] : undefined,
        nextPost: index !== self.length - 1 ? self[index + 1] : undefined,
      },
    }));
  const vrtPaths = vrtBlogCollection.map((post) => ({
    params: {
      year: util.getYearFromSlug(post.id),
      slug: util.stripYearFromSlug(post.id),
    },
    props: {
      post,
      prevPost: undefined,
      nextPost: undefined,
    },
  }));
  return [...blogPaths, ...vrtPaths];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const formatTime = (time: Date) => dayjs(time).format("YYYY/MM/DD (HH:mm)");
---

<Base title={post.data.title} type="article">
  <article itemscope itemtype="http://schema.org/Article">
    <div class="post-front">
      <h1 itemprop="headline">
        {post.data.title}
      </h1>
      <div class="dates">
        <p>
          投稿日:{" "}
          <time itemprop="datePublished">{formatTime(post.data.postdate)}</time>
        </p>
        {post.data.update.valueOf() !== post.data.postdate.valueOf() && (
          <p>
            更新日:{" "}
            <time itemprop="dateModified">{formatTime(post.data.update)}</time>
          </p>
        )}
      </div>
      <div class="tags">
        <TagIcon width={16} height={16} />
        {post.data.tags.map((tag) => (
          <a href={`/blog/tag/${tag.replace("#", "%23")}/`}>{tag}</a>
        ))}
      </div>
    </div>
    <div class="markdown" itemprop="articleBody"><Content /></div>
  </article>
  {(
    <nav>
      <ul class="pager">
        <li>
          {prevPost && (
            <a href={path.join("/blog", prevPost.id, "/")} rel="prev">
              ← {prevPost.data.title}
            </a>
          )}
        </li>
        <li>
          {nextPost && (
            <a href={path.join("/blog", nextPost.id, "/")} rel="next">
              {nextPost.data.title} →
            </a>
          )}
        </li>
      </ul>
    </nav>
  )}
</Base>

<style>
  article {
    padding: 1.4em;
    background-color: var(--color-surface);
    box-shadow: 0 0 10px #323232;
  }

  .post-front {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: 2rem;
    font-weight: bold;
  }

  .dates {
    display: flex;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .tags {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .tags a:not(:last-child)::after {
    content: ",";
  }

  .pager {
    display: grid;
    grid-auto-flow: column;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1rem 0;
  }
</style>
