---
import { render } from "astro:content";
import path from "node:path";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Time from "@/components/Time.astro";
import { allBlogCollection, util, vrtBlogCollection } from "@/content";
import TagIcon from "@/images/tag-icon.svg";
import Base from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
  const blogPaths = [...allBlogCollection]
    .sort((a, b) => a.data.postdate.valueOf() - b.data.postdate.valueOf())
    .map((post, index, self) => ({
      params: {
        year: util.getYearFromSlug(post.id),
        slug: util.stripYearFromSlug(post.id),
      },
      props: {
        post,
        prevPost: index !== 0 ? self[index - 1] : undefined,
        nextPost: index !== self.length - 1 ? self[index + 1] : undefined,
      },
    }));
  const vrtPaths = vrtBlogCollection.map((post) => ({
    params: {
      year: util.getYearFromSlug(post.id),
      slug: util.stripYearFromSlug(post.id),
    },
    props: {
      post,
      prevPost: undefined,
      nextPost: undefined,
    },
  }));
  return [...blogPaths, ...vrtPaths];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} type="article">
  <article itemscope itemtype="https://schema.org/Article">
    <header>
      <h1 itemprop="headline">
        {post.data.title}
      </h1>
      <div class="dates">
        <p>
          投稿日:{" "}
          <Time
            itemprop="datePublished"
            date={post.data.postdate}
            format="datetime"
          />
        </p>
        {post.data.update.valueOf() !== post.data.postdate.valueOf() && (
          <p>
            更新日:{" "}
            <Time
              itemprop="dateModified"
              date={post.data.update}
              format="datetime"
            />
          </p>
        )}
      </div>
      <div class="tags">
        <TagIcon width={16} height={16} aria-hidden="true" />
        <ul aria-label="タグ">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/blog/tag/${tag.replace("#", "%23")}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <div class="markdown" itemprop="articleBody"><Content /></div>
  </article>
  <nav aria-label="前後の記事">
    <ul class="pager">
      <li>
        {prevPost && (
          <a href={path.join("/blog", prevPost.id, "/")} rel="prev">
            ← {prevPost.data.title}
          </a>
        )}
      </li>
      <li>
        {nextPost && (
          <a href={path.join("/blog", nextPost.id, "/")} rel="next">
            {nextPost.data.title} →
          </a>
        )}
      </li>
    </ul>
  </nav>
</Base>

<style>
  article {
    padding: 1.4em;
    background-color: var(--color-surface);
    box-shadow: 0 0 10px #323232;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: 2rem;
    font-weight: bold;
  }

  .dates {
    display: flex;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .tags,
  .tags ul {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .tags li {
    display: flex;
  }

  .tags li:not(:last-child)::after {
    content: ",";
  }

  .pager {
    display: grid;
    grid-auto-flow: column;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1rem 0;
  }
</style>
