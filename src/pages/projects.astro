---
import { Image } from "astro:assets";
import dayjs from "dayjs";
import PageTitle from "@/components/PageTitle.astro";
import { allProjectsCollection } from "@/content";
import GitHubIcon from "@/images/github-invertocat.svg";
import Base from "@/layouts/Base.astro";

const SECTIONS = [
  { status: "active", heading: "Active" },
  { status: "maintained", heading: "Maintained" },
  { status: "completed", heading: "Completed" },
  { status: "archived", heading: "Archived" },
] as const;

// ref: https://github.com/ozh/github-colors
// biome-ignore format: keep "" and align
const LANG_COLOR: Record<string, string> = {
  "C":          "#555555",
  "C#":         "#178600",
  "Haskell":    "#5e5086",
  "Lua":        "#000080",
  "Python":     "#3572A5",
  "Rust":       "#dea584",
  "Svelte":     "#ff3e00",
  "TypeScript": "#3178c6",
  "Unity":      "#222c37",
  "Vim script": "#199f4b",
};

const sections = SECTIONS.map((section) => ({
  ...section,
  projects: allProjectsCollection
    .map((entry) => entry.data)
    .filter((p) => p.status === section.status)
    .sort((a, b) => b.updated.getTime() - a.updated.getTime()),
})).filter((section) => section.projects.length > 0);

function fmtYM(date: Date): string {
  return dayjs(date).format("YYYY/MM/DD");
}
---

<Base title="Projects" type="website">
  <PageTitle title="Projects" />
  {sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      <ul>
        {section.projects.map((p) => (
          <li>
            <div class="summary">
              <div class="heading">
                <h3>
                  <a href={p.url} target="_blank" rel="noreferrer">
                    {p.title}
                  </a>
                </h3>
                <div class="langs">
                  {p.langs.map((lang) => (
                    <span class="lang">
                      <span
                        class="lang-color"
                        style={{ background: LANG_COLOR[lang] ?? "#888" }}
                      />
                      {lang}
                    </span>
                  ))}
                </div>
              </div>
              <div class="description" set:html={p.description} />
              <div class="meta">
                <span>更新: {fmtYM(p.updated)}</span>
                <span>作成: {fmtYM(p.created)}</span>
                {p.github && (
                  <a
                    href={`https://github.com/${p.github}`}
                    target="_blank"
                    rel="noreferrer"
                    class="github"
                  >
                    <GitHubIcon width={14} height={14} />
                    {p.github}
                  </a>
                )}
              </div>
            </div>
            {p.image && (
              <Image
                src={p.image}
                alt=""
                class="thumbnail"
                data-vrt-mask={p.image.src.endsWith(".gif") || undefined}
              />
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  section {
    margin-top: 2rem;
  }

  h2 {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
    font-weight: bold;
  }

  ul {
    padding: 0 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-card-border);
    border-radius: 0.375rem;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  li + li {
    border-top: 1px solid var(--color-divider);
  }

  .summary {
    flex: 1;
    min-width: 0;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: bold;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lang-color {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .description {
    margin-top: 0.4rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .thumbnail {
    flex-shrink: 0;
    width: auto;
    height: 6rem;
    background-color: oklch(96.7% 0.003 264.542);
    border-radius: 0.25rem;
  }
</style>
